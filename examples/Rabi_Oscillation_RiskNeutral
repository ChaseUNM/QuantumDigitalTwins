function fidelity_gateset(gate_set::Vector{<:AbstractMatrix}, std_dev::Float64 = 0.1, degree::Int64 = 0, D1::Int64 = 1, samples::Int64 = 10000)
    N_gates = length(gate_set)
    pred_infidelity_list = zeros(N_gates)
    meas_infidelity_list = zeros(N_gates)

    center = 4.5
    # std_dev = 0.5
    gauss_distribution = Normal(center, std_dev)

    omega = rand(gauss_distribution)
    delta = omega - center
    H_drift = zeros(2,2)
    H_drift[2,2] = delta
    H_control_real = [0.0 1;
                    1   0]
    H_control_imag = [0.0 1;
                    -1  0]
    real_control_ops = [H_control_real]
    imag_control_ops = [H_control_imag]
    U0 = [1 0; 0 1]

    # degree = 0
    # D1 = 1
    

    t0 = 0.0
    T = 50.0 # time in nanoseconds
    # sim_T = 100.0 
    nsteps = 200
    sym_ops = [H_control_real]
    asym_ops = [H_control_imag]

    prob = SchrodingerProb(H_drift, real_control_ops, imag_control_ops, U0, T, nsteps)
    control = FortranBSplineControl(degree, D1, T)
    pcof0 = (0.5 .- rand(control.N_coeff)) .* max_control_parameter 
    for i in 1:N_gates 
        opt_gate = gate_set[i]
        opt_gate_prob = abs2.(opt_gate)
        opt_ret = optimize_prob(prob, control, pcof0, opt_gate, pcof_lbound=pcof_l, pcof_ubound=pcof_u, cost_type=:Infidelity, ipopt_options=["max_iter" => 100])
        pcof_optimal = opt_ret.x

        history_optimal = eval_forward(prob, control, pcof_optimal)
        final_prob_optimal = abs2.(history_optimal[:,end,:])
        # println("final prob optimal for gate $i:")
        # display(final_prob_optimal)
        pop1 = abs2.(history_optimal[:,:,1])'
        pop2 = abs2.(history_optimal[:,:,2])'
        println("std_dev: ", std_dev)
        epsilon_vec = (std_dev/10)*rand(2^nqubits)
        p_hat1, p_obs1 = create_synthetic_data(pop1, samples, epsilon_vec)
        p_hat2, p_obs2 = create_synthetic_data(pop2, samples, epsilon_vec)
        meas_gate_prob = hcat(p_hat1[end,:], p_hat2[end,:])
        I_pred = fidelity_probability(final_prob_optimal, opt_gate_prob)
        I_meas = fidelity_probability(meas_gate_prob, opt_gate_prob)
        pred_infidelity_list[i] = 1 - I_pred 
        meas_infidelity_list[i] = 1 - I_meas
        println("&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&")
        println()
        println("Predicted Infidelity for Gate $i: ", I_pred)
        println("Measured Infidelity for Gate $i: ", I_meas)
        println()
        println("&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&")
    end
    return pred_infidelity_list, meas_infidelity_list
end
