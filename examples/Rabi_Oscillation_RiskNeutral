function get_last_state(probs::Vector{<: SchrodingerProb}, control, pcof::AbstractVector)
    last_states = []
    last_states_pop = []
    N = length(probs)
    for i in 1:N 
        history_optimal = eval_forward(probs[i], control, pcof_optimal)
        push!(last_states, history_optimal[:,end,:])
        push!(last_states_pop, abs2.(history_optimal[:,end,:]))
    end
    return last_states, last_states_pop
end

function get_history(probs::Vector{<: SchrodingerProb}, control, pcof::AbstractVector, samples::Int64, epsilon_vec::AbstractVector)
    history = []
    history_pop = []
    last_states = []
    last_states_pop = []
    history_meas = []
    last_state_meas = []
    N = length(probs)
    for i in 1:N
        history_optimal = eval_forward(probs[i], control, pcof)
        push!(history, history_optimal)
        push!(history_pop, abs2.(history_optimal))
        push!(last_states, history_optimal[:,end,:])
        push!(last_states_pop, abs2.(history_optimal[:,end,:]))
        meas_data, _ = create_synthetic_data_full(abs2.(history_optimal), samples, epsilon_vec)
        push!(history_meas, meas_data)
        push!(last_state_meas, meas_data[:,end,:])
    end
    return history, history_pop , last_states, last_states_pop, history_meas, last_state_meas
end

