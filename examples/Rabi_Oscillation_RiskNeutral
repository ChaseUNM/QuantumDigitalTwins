function create_probs(center, std_dev, samples, degree, splines, gate, eps_vec, set_omegas = nothing)
    gauss_distribution = Normal(center, std_dev)

    gate_pop = abs2.(gate)

    x = range(1, 8, length=500)
    y = pdf.(gauss_distribution, x)

    distribution_plot = plot(x, y, xlabel=L"ω", label="Normal($center,$std_dev)", dpi = 250)

    H_control_real = [0.0 1;
    1 0]
    H_control_imag = [0.0 1;
    -1 0]
    real_control_ops = [H_control_real]
    imag_control_ops = [H_control_imag]
    U0 = [1 0; 0 1]
    t0 = 0.0
    T = 50.0 # time in nanoseconds
    nsteps = 200
    sym_ops = [H_control_real]
    asym_ops = [H_control_imag]

    omega_samples = samples
    omegas = rand(gauss_distribution, omega_samples)
    if set_omegas != nothing 
        omegas .= set_omegas 
    end
    deltas = omegas .- center

    probs = [SchrodingerProb(Float64[0 0; 0 delta], real_control_ops, imag_control_ops, U0, T, nsteps)
            for delta in deltas]

    max_control_parameter = 0.1
    pcof_l = -max_control_parameter
    pcof_u = max_control_parameter

    control = FortranBSplineControl(degree, splines, T)
    pcof0 = (0.5 .- rand(control.N_coeff)) .* max_control_parameter

    println("Optimizing 'risk-netural' multiple problem")
    println("Length of probs: ", length(probs))
    opt_ret_multiple = optimize_prob(probs, control, pcof0, gate, pcof_lbound=pcof_l, pcof_ubound=pcof_u, cost_type=:Infidelity, ipopt_options=["max_iter" => 100, "print_level" => 1])
    infidelity = opt_ret_multiple.obj_val
    pcof_optimal = opt_ret_multiple.x
    history, pop_history, last_state, last_state_pop, history_meas, last_state_meas = get_history(probs, control, pcof_optimal,10000,eps_vec)
    fidelity_pop = fidelity_probability_risk_neutral(last_state_pop, abs2.(gate_pop))
    infidelity_pop = 1 - fidelity_pop
    control_plot = plot_controls(control, pcof_optimal)
    #Also calculate measured fidelity
    meas_fidelity = fidelity_probability_risk_neutral(last_state_meas, abs2.(gate_pop))
    meas_infidelity = 1 - meas_fidelity

    t_range = LinRange(t0, T, nsteps + 1)
    p1, p2 = plot_risk_neutral(history, t_range, gate)

    return gauss_distribution, pcof_optimal, infidelity, infidelity_pop, meas_infidelity, p1, p2, distribution_plot, control_plot
end

