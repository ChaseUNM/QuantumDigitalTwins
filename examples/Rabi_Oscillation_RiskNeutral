function traffic_light_color(pred_inf, meas_inf, atol::Float64, eps::Float64)
    N_gates = length(pred_inf)
    approx_list_bool = []
    measure_list_bool = []
    pred_list_bool = []
    for i in 1:N_gates 
        if abs(pred_inf[i] - meas_inf[i]) < atol
            push!(approx_list_bool, true)
        else
            push!(approx_list_bool, false)
        end
        if meas_inf[i] < eps
            push!(measure_list_bool, true)
        else
            push!(measure_list_bool, false)
        end
        if pred_inf[i] < eps
            push!(pred_list_bool, true)
        else
            push!(pred_list_bool, false)
        end
    end
    # print(count(!, pred_list_bool))
    # print(sum(.!measure_list_bool))
    if sum(.!pred_list_bool) >= 1
        println("Red Light: Gates $(findall(!, pred_list_bool)) have predicted infidelities above the threshold, perform characterization and optimization to improve the predicted infidelity values.")
        return 1
    elseif pred_list_bool == [true, true, true] && sum(.!measure_list_bool) >= 2
        println("Red Light: Most gates have a measured infidelity above the threshold, even if the predicted infidelities are low.")
        return 2
    elseif pred_list_bool == [true, true, true] && sum(.!measure_list_bool) == 1
        println("Yellow Light: Most gates have predicted and measured infidelities within the acceptable range, but gate $(findfirst(!, measure_list_bool)) has a measured infidelity above the threshold.")
        return 3
    elseif all(approx_list_bool) && all(measure_list_bool)
        println("Green Light: All gates have predicted and measured infidelities within the acceptable range.")
        return 0
    else
        println("Other case, check the infidelity values and thresholds.")
        return 4
    end
    println("approx_list_bool: ", approx_list_bool)
    println("measure_list_bool: ", measure_list_bool)
    println("pred_list_bool: ", pred_list_bool)
    
end

